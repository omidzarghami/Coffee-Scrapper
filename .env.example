# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier friendly Flash models (first available is used)
GEMINI_MODEL=gemini-2.5-flash

# How many unseen articles to process per run
MAX_ARTICLES=1

# Polite delay between page fetches (seconds)
DELAY_MIN=1.2
DELAY_MAX=2.4

# Telegram channel bot (never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
